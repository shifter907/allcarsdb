  },
  "dependencies": {
    "@allcarsdb/query": "*",
    "@allcarsdb/schema": "*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@hono/node-server": "^1.13.7",
    "tsx": "^4.19.2",
    "wrangler": "^3.99.0"
  }
}
