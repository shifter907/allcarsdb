{
  "name": "@allcarsdb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "dev:wrangler": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:import": "wrangler d1 execute allcarsdb --remote --file=../../dist/allcars.sql",
